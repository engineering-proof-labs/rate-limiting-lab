# Application Environment Configuration (Safe Defaults)
PORT=3000
NODE_ENV=development

# Redis Distributed Backing Store
# The server honors REDIS_URL if provided, or falls back to REDIS_HOST and REDIS_PORT.
# Note: .env files are not automatically loaded by default unless specified (e.g. node --env-file=.env).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379

# Demonstration Mode (Disabled by default; enable only for local multi-client testing)
# ENABLE_DEMO_HEADERS=true
